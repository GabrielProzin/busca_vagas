{
  "manifest_version": 3,
  "name": "Enviar para o busca_vagas",
  "version": "1.0.0",
  "description": "Selecione o texto de uma vaga, clique com o botão direito e mande para o seu busca_vagas avaliar.",
  "permissions": ["contextMenus", "storage", "notifications", "activeTab", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "options_page": "opcoes.html",
  "action": { "default_title": "busca_vagas: opções", "default_icon": { "16": "icones/16.png", "32": "icones/32.png" } },
  "icons": { "16": "icones/16.png", "48": "icones/48.png", "128": "icones/128.png" }
}
