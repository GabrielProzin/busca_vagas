# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Senha para entrar no site.
SITE_PASSWORD=
# 32+ caracteres aleatórios. Gere com: openssl rand -base64 48
SESSION_SECRET=
# Fase 3: IA (aistudio.google.com) e envio pelo Gmail (senha de app, myaccount.google.com/apppasswords)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite   # opcional; o padrão tenta os Flash-Lite atuais
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Telefone na assinatura dos emails (opcional; fica fora do repositório público)
# CONTATO_TELEFONE=+55 62 9....-....
# Token da extensão do navegador: 24+ caracteres aleatórios (mesmo valor nas opções da extensão)
CAPTURA_TOKEN=
# LIMITE_DIARIO_EMAILS=40
# Opcional, só para desenvolver sem banco: caminho de um JSON gerado pelo coletor (saida/vagas_*.json)
# DEMO_ARQUIVO=../saida/vagas_2026-10-20.json
